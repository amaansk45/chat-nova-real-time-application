# ChatNova Backend Configuration
DEBUG=True
SECRET_KEY=chatnova-insecure-development-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL with automatic SQLite fallback)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=chatnova_db
# DB_USER=chatnova_user
# DB_PASSWORD=secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Redis & Channel Layer Configuration (Redis with automatic InMemory fallback)
REDIS_URL=redis://127.0.0.1:6379/1
USE_REDIS_CHANNEL_LAYER=False

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media & Storage
MEDIA_URL=/media/
MEDIA_ROOT=media/

# AI Assistant Provider API Key (optional mock/live)
AI_API_KEY=

